{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    "resolveJsonModule": true
  },
  "include": ["node/**/*.ts", "viewer/**/*.tsx", "viewer/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
